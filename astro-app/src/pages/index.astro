---
import { createClient } from "../lib/pocketbase";

const title = "Amigochi POC";
const pb = createClient();

interface AdRoom {
  title: string;
  description?: string;
  rent?: number;
  expenses?: string;
  availability?: string;
  duration?: string;
}

let records: AdRoom[] = [];
let error: string | null = null;

try {
  records = await pb.collection("ad_room").getFullList<AdRoom>({
    sort: "created",
  });
} catch {
  error = "Could not load ad rooms. PocketBase may be unreachable.";
}

const formatRent = (rent?: number) =>
  rent == null
    ? "On request"
    : new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" }).format(rent);

const formatDate = (date?: string) =>
  date ? new Date(date).toLocaleDateString("es-ES") : "TBA";

const expenseLabels: Record<string, string> = {
  incluidos: "Utilities included",
  aparte: "Utilities separate",
  "a consultar": "On request",
};

const durationLabels: Record<string, string> = {
  short: "Short term",
  medium: "Medium term",
  long: "Long term",
  negotiable: "Negotiable",
};
---

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #f3f4f6;
    color: #111827;
  }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0;
  }

  .count {
    color: #6b7280;
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .card h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .rent {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    background: #eef2ff;
    color: #3730a3;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.78rem;
  }

  .description {
    color: #4b5563;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .description :global(p) {
    margin: 0;
  }

  .error {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-top: 1.5rem;
  }

  .empty {
    color: #6b7280;
    margin-top: 1.5rem;
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header>
        <h1>{title} — Ad Rooms</h1>
        {!error && <span class="count">{records.length} room(s)</span>}
      </header>

      {error ? (
        <div class="error">{error}</div>
      ) : records.length === 0 ? (
        <p class="empty">No ad rooms yet.</p>
      ) : (
        <div class="grid">
          {records.map((room) => (
            <article class="card">
              <h2>{room.title}</h2>
              <div class="rent">{formatRent(room.rent)}</div>
              <div class="meta">
                {room.expenses && (
                  <span class="badge">{expenseLabels[room.expenses] ?? room.expenses}</span>
                )}
                {room.duration && (
                  <span class="badge">{durationLabels[room.duration] ?? room.duration}</span>
                )}
                <span class="badge">Available {formatDate(room.availability)}</span>
              </div>
              {room.description && (
                <div class="description" set:html={room.description} />
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </body>
</html>
